APP_NAME="E-book Emagrecer Verao"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco ---
# Docker local: use os valores abaixo (serviço "mysql" do docker-compose).
# EthioDeploy: NÃO preencha DB_HOST/DB_DATABASE/etc.
#   1) No projeto → Addons → adicione MySQL
#   2) A plataforma injeta DATABASE_URL sozinha
#   3) No painel de env, coloque só: DB_CONNECTION=mysql
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ebook
DB_USERNAME=ebook
DB_PASSWORD=ebook
# DB_URL=          # opcional; EthioDeploy usa DATABASE_URL (já mapeado no código)


# Drivers leves (sem Redis/worker). Em EthioDeploy use os mesmos.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="lojavirtualrbs.oficial@gmail.com"
MAIL_FROM_NAME="Loja Virtual RBS"

# --- Brevo (e-mail com PDF) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=lojavirtualrbs.oficial@gmail.com
BREVO_SENDER_NAME="Loja Virtual RBS"

# --- Asaas (PIX) ---
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/api/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Chave começa com $aact_... — no painel EthioDeploy escape o $ se ele for interpretado.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# PDF privado (fora de public/). Vazio = storage/app/private/ebook.pdf
EBOOK_PATH=

# --- Só desenvolvimento local (Ngrok) ---
NGROK_API_URL=http://host.docker.internal:4040
NGROK_URL=
HTTP_PORT=8080

# =============================================================================
# EthioDeploy — variáveis obrigatórias no painel (Root Directory = backend)
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:...          # php artisan key:generate --show
# APP_URL=https://ebookemagrecarapidoverao.ethiodeploy.app
# LOG_CHANNEL=stderr
# LOG_LEVEL=error
#
# DB_CONNECTION=mysql
# (não invente DB_HOST — Addons → MySQL injeta DATABASE_URL)
#
# Start command (para criar as tabelas):
# php artisan migrate --force && ethiodeploy-start
#
# ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# ASAAS_API_KEY='\$aact_...'  # valor completo; escape $ se necessário
# ASAAS_WEBHOOK_TOKEN=...
#
# BREVO_API_KEY=...
# BREVO_SENDER_EMAIL=lojavirtualrbs.oficial@gmail.com
# BREVO_SENDER_NAME="Loja Virtual RBS"
#
# EBOOK_PATH=storage/app/private/ebook.pdf
# SESSION_DRIVER=file
# QUEUE_CONNECTION=sync
# CACHE_STORE=file
#
# Não defina NGROK_URL nem NGROK_API_URL em produção.
